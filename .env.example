# Export these variables in your MCP client's environment; this file is not loaded automatically.
MSF_RPC_URL=http://127.0.0.1:55553/api/
MSF_RPC_USER=msf
MSF_RPC_PASS=replace-with-your-local-rpc-password
# Alternative to username/password: MSF_RPC_TOKEN
# MSF_RPC_TIMEOUT=30
# MSF_RPC_VERIFY_TLS=true
# MSF_RPC_CA_FILE=/absolute/path/to/ca.pem
# MSF_RPC_MAX_RESPONSE_BYTES=67108864
